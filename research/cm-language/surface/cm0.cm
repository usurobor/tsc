# CM0 — the coherence methodology whose target is another coherence methodology,
# authored in the compact ML-shaped .cm surface (issue #115 + full-source follow-on).
#
# CM0 measures a candidate methodology AS A MEASUREMENT INSTRUMENT. It measures
# only: it does not compile, admit, authorize, repair, or self-authorize.
#
# This one source is a FAITHFUL, lossless carrier of the full authored #CMSource:
#   cmc cm0.cm            → the normalized IR   (== compiled/cm0.json)
#   cmc --source cm0.cm   → the full source     (== `cue export … -e cm0`),
#                            content-addressed provider digests and per-step
#                            input/output/evidence contracts included.

cm cm0 v0.1 (instrument: Methodology) -> InstrumentAssessment {

  question "Is this candidate coherence methodology fit, within its declared scope, to act as a measurement instrument?"

  # The accepted-target contract: CM0 measures a candidate methodology (not a repo).
  target coherence_methodology "a candidate coherence methodology, presented as CM source + its normalized IR (+ an optional later CompiledCM), assessed as a measurement instrument."

  # Content address of the authored #CMSource (sha256 of its canonical CUE export).
  # IR-level field only; the full source expr does not carry it.
  source_digest sha256:a1b45680fcca5f254ba4d3e204d75fc32d6feef9a7a735d697882da48e9da3dc

  # Input: an #InstrumentSubject. normalized_ir grounds language-level contract
  # integrity and is required; compiled (the later runtime CompiledCM) is not, and
  # with none bound the runtime binding stays INCOMPLETE.
  require source        : cm_source
  require normalized_ir : normalized_cm_ir
  require compiled      : compiled_cm optional
  lists   implementation_refs, calibrations, fixtures, lineage
  binding INCOMPLETE
  standing "the candidate methodology's own declared scope; CM0 asserts nothing beyond it, and a self-assessment is a hygiene check only, never sole standing (tsc-oper.md §4.4)."

  # The five subcontracts as typed, provider-bound steps. Each names its #StepKind,
  # the provider (`via <provider_kind> <provider_id> @<digest>`, content-addressed),
  # the #ResultClass a provider failure maps to (`on <FAIL>`), and its input /
  # output / evidence contracts. let! introduces the first bound step; and! adds
  # independent parallel ones (F#-style workflow).
  let! contract_integrity = mechanical via tool ir_contract_checker @sha256:ic0 on FAILED {
    reads    subject.normalized_ir, subject.source
    output   parts_present: bool, relations_consistent: bool, scope: language_level
    evidence ir_field_citations_required: true
  }
  and! repeatability = oracle via oracle determinism_oracle @sha256:rp0 on INCOMPLETE {
    reads    subject.normalized_ir, subject.calibrations
    protocol repeat_same_input
    output   repeat_consistent: bool, divergences: list
    evidence repeat_receipts_retained: true
  }
  and! discrimination = invoke_cm via cm control_separation_cm @sha256:ds0 on INCOMPLETE {
    methodology candidate @sha256:cand
    reads    subject.fixtures, subject.calibrations
    output   shape: measurement_receipt, separates_positive_negative: bool
    evidence control_receipts_retained: true
  }
  and! refusal = semantic_judgment via llm refusal_judge @sha256:rf0 on INCOMPLETE {
    skill    refusal-rubric skill @sha256:sk0 v0.1
    reads    subject.fixtures, subject.normalized_ir
    output   refuses_out_of_domain: bool, refuses_malformed: bool, false_pass_detected: bool
    evidence citations_required: true, disagreement_retained: true
  }
  and! evolution = mechanical via tool evolution_rule_checker @sha256:ev0 on FAILED {
    reads    subject.normalized_ir, subject.lineage
    output   stable_ids: bool, migration_rules_present: bool, retirement_rules_present: bool
    evidence lineage_citations_required: true
  }

  # The measure-only receipt's reported dimensions (all optional; 4A computes no
  # results). This is receipt_contract.reports in the IR.
  retain parts_present, relations_fit, evolution_rules, repeat_consistency,
         discrimination, refusal_behavior, calibration_evidence, defects, uncertainty

  # Result: an InstrumentAssessment over the subcontracts, deferred to a run.
  decide from assessments deferred "deferred to a measurement run (increment 4C); no result computed in the source/IR"

  # Measure-only boundary, structurally mandatory and complete: CM0 measures; it
  # does NOT compile (compiler), admit (V), authorize (δ), repair, or self-
  # authorize. The language-level face of OPER-AUTH-001 ("CM0 cannot admit itself").
  boundary_note "CM0 measures a candidate methodology as an instrument and emits an InstrumentAssessment only. Compilation (compiler), admission (V), authorization (δ), boundary decisions (δ), and repair are distinct authorities; no surface assumes another's."
  forbid compile, admit, authorize, repair, self_authorize
}
