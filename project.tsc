# TSC project measurement configuration
#
# This is the live config surface consumed by the current Python orchestrator.
# It uses repeated [markdown] sections because that is what the parser understands today.
#
# The named-target model lives in:
#   - targets/registry.tsc
#   - targets/*.tsc
#
# When the orchestrator supports the target registry, targets/registry.tsc
# replaces this file as the authoritative config surface.

[markdown]
file = "README.md"
alpha = "pattern_coherence"
beta = "relational_coherence"

[markdown]
file = "spec/c-equiv.md"
alpha = "pattern_coherence"
beta = "relational_coherence"
