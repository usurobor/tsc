format = "tsc-target/0.1"
name = "methodology"
kind = "aggregate"
description = "The 1st coherence methodology as a measurable corpus: the self-measurement declaration, its schema, validators, renderer, rendered surfaces, scoring instruction, corpus declarations, and the engine modules its pipeline names."

include = [
  "src/skills/README.md",
  "src/skills/self-measure/**",
  "schemas/skill.cue",
  "schemas/README.md",
  "scripts/render-self-measure.sh",
  "scripts/coh-self",
  "scripts/coherence-ledger.sh",
  "scripts/ci/validate-skill-frontmatter.sh",
  "scripts/ci/self-measure-smoke.sh",
  ".github/workflows/tsc-self-measure.yml",
  ".github/workflows/tsc-coherence-ledger.yml",
  "runtime/SELF-MEASURE.md",
  "targets/registry.tsc",
  "targets/spec.tsc",
  "targets/engine.tsc",
  "targets/repo.tsc",
  "src/engine/ocaml/lib/target_registry.ml",
  "src/engine/ocaml/lib/bundle.ml",
  "src/engine/ocaml/lib/mechanical_scoring.ml",
  "src/engine/ocaml/lib/mechanical_scoring.mli",
  "src/engine/ocaml/lib/prompt.ml",
  "src/engine/ocaml/lib/response_schema.ml",
  "src/engine/ocaml/lib/coherence.ml",
  "src/engine/ocaml/lib/report.ml",
  "src/engine/ocaml/lib/hybrid_scoring.ml",
  "src/engine/ocaml/lib/cross_target.ml"
]

exclude = [
  ".tsc/**"
]
