# TSC target registry
#
# This file defines the named-target model.
# The engine reads this file to resolve target names to manifests.

format = "tsc-target-registry/0.1"
default_target = "repo"

[target.spec]
manifest = "targets/spec.tsc"

[target.engine]
manifest = "targets/engine.tsc"

[target.repo]
manifest = "targets/repo.tsc"
