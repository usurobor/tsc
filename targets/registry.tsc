# TSC target registry (draft)
#
# This file defines the named-target model.
# It is not yet consumed by the current Python orchestrator.
# The live config remains in project.tsc.

format = "tsc-target-registry/0.1"
default_target = "repo"

[target.spec]
manifest = "targets/spec.tsc"

[target.engine]
manifest = "targets/engine.tsc"

[target.repo]
manifest = "targets/repo.tsc"
