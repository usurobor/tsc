format = "tsc-target/0.1"
name = "engine"
kind = "implementation"
description = "Current repository-proxy implementation surface."

include = [
  "src/engine/ocaml/README.md",
  "src/engine/ocaml/CONTRACT.md",
  "src/engine/ocaml/**/*.ml",
  "src/engine/ocaml/**/*.mli",
  "src/engine/ocaml/dune-project",
  "src/engine/ocaml/lib/dune",
  "src/engine/ocaml/bin/dune",
  "src/engine/ocaml/test/fixtures/*.json"
]

exclude = [
  ".tsc/**",
  "spec/**",
  "examples/**",
  "targets/**",
  "src/engine/ocaml/_build/**",
  "README.md",
  "ARCHITECTURE.md",
  "QUICKSTART.md"
]
