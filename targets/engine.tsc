format = "tsc-target/0.1"
name = "engine"
kind = "implementation"
description = "Canonical implementation surface."

include = [
  "engine/ocaml/README.md",
  "engine/ocaml/**/*.ml",
  "engine/ocaml/**/*.mli",
  "engine/ocaml/dune-project",
  "engine/ocaml/lib/dune",
  "engine/ocaml/bin/dune",
  "engine/ocaml/test/fixtures/*.json",
  "tests/ocaml/**"
]

exclude = [
  ".tsc/**",
  "spec/**",
  "examples/**",
  "targets/**",
  "engine/ocaml/_build/**",
  "README.md",
  "ARCHITECTURE.md",
  "QUICKSTART.md"
]
