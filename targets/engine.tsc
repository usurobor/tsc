format = "tsc-target/0.1"
name = "engine"
kind = "implementation"
description = "Current executable implementation surface."

include = [
  "reference/python/**/*.py",
  "tests/**/*.py",
  "pyproject.toml",
  "Makefile"
]

optional = [
  "engine/ocaml/**"
]

exclude = [
  ".tsc/**",
  "spec/**",
  "examples/**",
  "targets/**",
  "README.md",
  "ARCHITECTURE.md",
  "QUICKSTART.md",
  "project.tsc"
]
