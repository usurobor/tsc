format = "tsc-target/0.1"
name = "repo"
kind = "aggregate"
description = "Aggregate repository target across theory, implementation, and integration surfaces."

include_targets = [
  "spec",
  "engine"
]

include = [
  "README.md",
  "ARCHITECTURE.md",
  "QUICKSTART.md",
  "STATUS.md",
  "CITATION.cff",
  "conformance/**",
  "schemas/conformance-fixture.cue",
  "src/engine/ocaml/CONTRACT.md",
  "docs/concepts/illustrations/**",
  "runtime/SELF-MEASURE.md",
  "targets/README.md",
  "targets/registry.tsc",
  "docs/THESIS.md",
  "docs/README.md",
  "docs/alpha/README.md",
  "docs/beta/README.md",
  "docs/gamma/README.md",
  "docs/beta/guides/OPERATOR-MANUAL.md",
  "docs/beta/governance/DOCUMENTATION-SYSTEM.md",
  "docs/alpha/doctrine/README.md",
  "docs/alpha/doctrine/3.2.0/SELF-COHERENCE.md",
  "docs/alpha/engine/README.md",
  "docs/alpha/engine/0.1.0/README.md",
  "docs/alpha/engine/0.1.0/DESIGN.md",
  "docs/alpha/engine/0.1.0/PLAN.md",
  "docs/alpha/engine/0.1.0/SELF-COHERENCE.md",
  "docs/alpha/engine/0.3.0/DESIGN.md",
  "docs/alpha/engine/0.3.0/PLAN.md",
  "docs/alpha/engine/0.3.0/POST-RELEASE-ASSESSMENT.md",
  "docs/alpha/engine/0.4.0/POST-RELEASE-ASSESSMENT.md",
  "docs/alpha/engine/0.5.0/POST-RELEASE-ASSESSMENT.md",
  "CHANGELOG.md",
  "katas/README.md",
  "src/skills/README.md",
  "src/skills/self-measure/**",
  "schemas/README.md",
  "schemas/skill.cue",
  "scripts/coh-self",
  "scripts/render-self-measure.sh",
  "scripts/ci/validate-skill-frontmatter.sh",
  "scripts/ci/self-measure-smoke.sh",
  ".github/workflows/tsc-self-measure.yml"
]

exclude = [
  ".tsc/**"
]
