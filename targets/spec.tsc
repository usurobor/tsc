format = "tsc-target/0.1"
name = "spec"
kind = "theory"
description = "Canonical theory surface."

include = [
  "spec/**/*.md"
]

exclude = [
  ".tsc/**",
  "engine/**",
  "runtime/**",
  "tests/**",
  "examples/**",
  "targets/**",
  "README.md",
  "docs/quickstart/README.md",
  "docs/architecture/README.md"
]
