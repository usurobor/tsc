format = "tsc-target/0.1"
name = "spec"
kind = "theory"
description = "Canonical theory surface."

include = [
  "spec/**/*.md"
]

exclude = [
  ".tsc/**",
  "reference/**",
  "runtime/**",
  "tests/**",
  "examples/**",
  "targets/**",
  "project.tsc",
  "README.md",
  "QUICKSTART.md",
  "ARCHITECTURE.md"
]
