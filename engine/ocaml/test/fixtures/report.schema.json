{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Canonical TSC report schema — all modes must satisfy required fields.",
  "type": "object",
  "required": ["mode", "alpha", "beta", "gamma", "c_sigma", "bottleneck_axis"],
  "properties": {
    "target": { "type": ["string", "null"] },
    "mode": {
      "type": "string",
      "enum": ["mechanical", "llm", "hybrid"]
    },
    "alpha":          { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "beta":           { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "gamma":          { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "c_sigma":        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "bottleneck_axis":{ "type": "string", "enum": ["alpha", "beta", "gamma"] },
    "mechanical": {
      "type": "object",
      "description": "Present in hybrid mode only.",
      "required": ["alpha", "beta", "gamma", "c_sigma", "evidence_kind"],
      "properties": {
        "alpha":        { "type": "number" },
        "beta":         { "type": "number" },
        "gamma":        { "type": "number" },
        "c_sigma":      { "type": "number" },
        "evidence_kind":{ "type": "string", "enum": ["structural-proxy"] }
      }
    },
    "llm": {
      "type": "object",
      "description": "Present in hybrid mode only.",
      "required": ["alpha", "beta", "gamma", "c_sigma", "evidence_kind"],
      "properties": {
        "alpha":        { "type": "number" },
        "beta":         { "type": "number" },
        "gamma":        { "type": "number" },
        "c_sigma":      { "type": "number" },
        "evidence_kind":{ "type": "string", "enum": ["semantic-judgment"] }
      }
    },
    "final": {
      "type": "object",
      "description": "Present in hybrid mode only.",
      "required": ["source", "alpha", "beta", "gamma", "c_sigma"],
      "properties": {
        "source": { "type": "string", "enum": ["llm", "mechanical", "agreement"] },
        "alpha":  { "type": "number" },
        "beta":   { "type": "number" },
        "gamma":  { "type": "number" },
        "c_sigma":{ "type": "number" }
      }
    }
  }
}
