# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.12.0"
synopsis: "TSC measurement engine — OCaml-first, LLM-native"
authors: ["Peter Lisovin"]
license: "CC-BY-4.0"
homepage: "https://github.com/usurobor/tsc"
bug-reports: "https://github.com/usurobor/tsc/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.0"}
  "digestif"
  "yojson"
  "ezcurl"
  "otoml"
  "ppx_expect" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/usurobor/tsc.git"
