# This file is generated by dune, edit dune-project instead.
# See https://dune.readthedocs.io/en/latest/dune-files.html#dune-project

opam-version: "2.0"
name: "tsc_engine"
synopsis: "TSC measurement engine — OCaml-first, LLM-native"
license: "CC-BY-4.0"
authors: ["Peter Lisovin"]
homepage: "https://github.com/usurobor/tsc"
bug-reports: "https://github.com/usurobor/tsc/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.0"}
  "digestif"
  "yojson"
  "ezcurl"
  "ppx_expect" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    "tsc_engine"
    "-j"
    "jobs"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/usurobor/tsc.git"
