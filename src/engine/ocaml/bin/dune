(executable
 (name main)
 (public_name coh)
 (modules main provider dotenv build_version build_commit)
 (libraries tsc_engine unix ezcurl))

(rule
 (target build_version.ml)
 (deps ../../../../VERSION)
 (action (bash "echo 'let version = \"'$(cat %{deps}| tr -d '\\n')'\"' > %{target}")))

(rule
 (target build_commit.ml)
 (deps (universe))
 (action (bash "echo 'let commit = \"'$(git rev-parse --short HEAD 2>/dev/null || echo unknown)'\"' > %{target}")))
